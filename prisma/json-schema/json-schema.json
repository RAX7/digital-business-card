{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "email": {
          "type": "string"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Skill"
          }
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Project"
          }
        },
        "experience": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Experience"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "email",
        "firstName",
        "updatedAt"
      ]
    },
    "Skill": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Profile"
          }
        }
      },
      "required": [
        "name",
        "description"
      ]
    },
    "Experience": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "company": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "firstWorkDay": {
          "type": "string",
          "format": "date-time"
        },
        "lastWorkDay": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "profile": {
          "$ref": "#/definitions/Profile"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "company",
        "position",
        "profileId",
        "updatedAt"
      ]
    },
    "Project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "profile": {
          "$ref": "#/definitions/Profile"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "description",
        "profileId",
        "updatedAt"
      ]
    }
  },
  "type": "object",
  "properties": {
    "profile": {
      "$ref": "#/definitions/Profile"
    },
    "skill": {
      "$ref": "#/definitions/Skill"
    },
    "experience": {
      "$ref": "#/definitions/Experience"
    },
    "project": {
      "$ref": "#/definitions/Project"
    }
  }
}